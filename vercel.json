{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "//": "The production alias serves the whole site a second time, with its own robots.txt saying Allow: / and no X-Robots-Tag — Vercel only adds that to preview deployments, and this is aliased as production. Every page is duplicated on a domain Google can crawl. Sending the host to the real one consolidates it instead of merely hiding it. next.config headers and middleware are both ignored under output: export, so this is the only layer that can do it.",
      "source": "/:path*",
      "has": [{ "type": "host", "value": "jasoberoi-pied.vercel.app" }],
      "destination": "https://www.oberizonconstruction.ca/:path*",
      "permanent": true
    },
    {
      "source": "/residential-projects",
      "destination": "/services/luxury-residential-construction/",
      "permanent": true
    },
    {
      "source": "/residential-projects/",
      "destination": "/services/luxury-residential-construction/",
      "permanent": true
    },
    {
      "source": "/commercial-projects",
      "destination": "/services/commercial-construction/",
      "permanent": true
    },
    {
      "source": "/commercial-projects/",
      "destination": "/services/commercial-construction/",
      "permanent": true
    },
    {
      "source": "/service-vancouver",
      "destination": "/construction/vancouver/commercial-construction/",
      "permanent": true
    },
    {
      "source": "/service-vancouver/",
      "destination": "/construction/vancouver/commercial-construction/",
      "permanent": true
    },
    {
      "source": "/landing-page",
      "destination": "/services/dental-clinic-construction/",
      "permanent": true
    },
    {
      "source": "/landing-page/",
      "destination": "/services/dental-clinic-construction/",
      "permanent": true
    },
    {
      "source": "/thank-you",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/thank-you/",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/about-us/",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/projects/",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/projects/",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/projects/",
      "permanent": true
    },
    {
      "source": "/blog/:path*/",
      "destination": "/projects/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/_not-found",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/_not-found/",
      "destination": "/",
      "permanent": true
    }
  ]
}
