{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "jasoberoi-pied.vercel.app" }],
      "destination": "https://www.oberizonconstruction.ca/$1",
      "permanent": true
    },
    {
      "source": "/residential-projects",
      "destination": "/services/luxury-residential-construction/",
      "permanent": true
    },
    {
